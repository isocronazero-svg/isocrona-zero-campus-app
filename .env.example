NODE_ENV=production
PORT=3210
IZ_BASE_URL=https://example.com
IZ_DATA_DIR=/data/isocrona-zero

IZ_RECOVERY_ADMIN_EMAIL=admin@example.com
IZ_RECOVERY_ADMIN_PASSWORD=change-me-long-random-password

AUTOMATION_INTERVAL_MS=300000
IZ_ASSOCIATE_SELF_EDIT_DAYS=30

# Ruta opcional al Excel real de socios
# IZ_ASSOCIATES_WORKBOOK=C:\Users\charl\Downloads\CUOTAS SOCIOS (1).xlsx

# PostgreSQL opcional
# DATABASE_URL=
# DATABASE_SSL=true
# DB_SSL_ALLOW_SELF_SIGNED=false

# SMTP opcional para correos reales
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Correo por HTTPS compatible con Railway Hobby. Clave solo en el servidor.
# IZ_EMAIL_PROVIDER=resend
# RESEND_API_KEY=
# IZ_EMAIL_FROM=campus@isocronazero.org
# IZ_EMAIL_FROM_NAME=Isócrona Zero · Campus
# IZ_EMAIL_REPLY_TO=isocronazero@gmail.com
# IZ_EMAIL_TEST_TO=isocronazero@gmail.com
# Mantener false hasta verificar dominio, prueba y destinatarios pendientes.
# IZ_EMAIL_ENABLED=false
