# Plantilla QA V1.1 — NO introducir secretos reales en este archivo.
# Copiar localmente a .env.qa (ignorado por Git) o configurar estas variables
# directamente como secretos/variables privadas en Railway.

NODE_ENV=production
IZ_DATA_DIR=/var/data/isocrona-zero
IZ_DEFAULT_STATE_PATH=/app/data/qa-private-seed.json
IZ_EMAIL_ENABLED=false
IZ_BASE_URL=https://CAMBIAR-AL-DOMINIO-QA-PROTEGIDO

# Credenciales bootstrap: configurar SOLO como secretos en Railway o en .env.qa local.
# No escribir valores reales en este archivo ni en commits.
IZ_BOOTSTRAP_ADMIN_EMAIL=
IZ_BOOTSTRAP_ADMIN_PASSWORD=
IZ_BOOTSTRAP_ADMIN_NAME=Administrador QA
